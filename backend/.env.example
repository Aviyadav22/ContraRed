# ContraRed Backend — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Application
APP_NAME=ContraRed
DEBUG=true

# Database (Supabase PostgreSQL — use port 5432 direct, NOT 6543 PgBouncer)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Redis (optional — app degrades gracefully without it)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication — REQUIRED: generate a secure random key (min 32 chars)
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI — REQUIRED for AI features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-2.5-pro-preview-03-25
GEMINI_SCOUT_MODEL=gemini-2.0-flash-lite
GEMINI_SURGEON_MODEL=gemini-2.0-flash-lite
AI_PROVIDER=gemini

# Azure OpenAI (alternative to Gemini)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# Razorpay Payments (required for billing features)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO_ID=
RAZORPAY_PLAN_ENTERPRISE_ID=

# CORS Origins — JSON array of allowed frontend URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://contrared-dashboard.netlify.app","https://contrared-addin.netlify.app"]

# Analysis mode: "demo" (Omni-Context) or "production" (Hybrid Sentinel)
ANALYSIS_MODE=demo

# Fuzzy matching threshold for redline implementer (0.0-1.0)
FUZZY_MATCH_THRESHOLD=0.85

# Zero Data Retention — enterprise privacy mode
ZERO_DATA_RETENTION=true

# Subscription Limits
FREE_TIER_SCANS=5
PRO_TIER_SCANS=-1
ENTERPRISE_INCLUDED_SCANS=500
