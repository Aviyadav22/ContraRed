# ContraRed Backend Environment Configuration

# Application
APP_NAME=ContraRed
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contrared

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Azure OpenAI (optional - keeping for backward compatibility)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# Google Gemini API (primary AI provider - recommended)
GEMINI_API_KEY=your-gemini-api-key
# Main model for demo mode - use pro for best quality
GEMINI_MODEL=gemini-3-pro-preview
# Scout model for hybrid search (light/fast)
GEMINI_SCOUT_MODEL=gemini-3-flash-preview
# Surgeon model for deep analysis (pro/powerful)
GEMINI_SURGEON_MODEL=gemini-3-pro-preview

# AI Provider selection: "gemini" or "azure"
AI_PROVIDER=gemini

# Analysis Strategy: "demo" (full context) or "production" (two-pass hybrid)
ANALYSIS_MODE=demo

# Fuzzy matching threshold for redline implementer (0.0-1.0)
FUZZY_MATCH_THRESHOLD=0.85

# Razorpay (fill with your credentials)
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret

# CORS Origins
CORS_ORIGINS=["https://localhost:3000","http://localhost:3000","http://localhost:5173"]

# Subscription Limits
FREE_TIER_SCANS=5
PRO_TIER_SCANS=-1
ENTERPRISE_INCLUDED_SCANS=500
