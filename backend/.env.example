# ContraRed Backend — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Application
APP_NAME=ContraRed
DEBUG=true

# Database (Supabase PostgreSQL — use port 5432 direct, NOT 6543 PgBouncer)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Redis (optional — app degrades gracefully without it)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication — REQUIRED: generate a secure random key (min 32 chars)
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_BLACKLIST_TTL_SECONDS=604800

# Cookie Settings (cross-origin auth for Word Add-in iframe)
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Vertex AI — REQUIRED for AI features (enterprise, India data residency)
# 1. Create a GCP project and enable the Vertex AI API
# 2. Create a service account with Vertex AI User role
# 3. Set GOOGLE_APPLICATION_CREDENTIALS to the raw JSON key content (for Render/PaaS)
#    or a file path (for local dev / VMs)
# 4. Execute a DPA with Google Cloud for production use
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-south1
# Paste the full service account JSON here (or a file path for local dev):
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini model names (served via Vertex AI)
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_ANALYSIS_MODEL=gemini-3.1-pro-preview
GEMINI_SCOUT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_SURGEON_MODEL=gemini-3.1-flash-lite-preview
AI_PROVIDER=gemini

# Azure OpenAI (alternative to Gemini)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_SCOUT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_SURGEON_DEPLOYMENT=gpt-4o

# Razorpay Payments (INR — required for billing features)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_PRO_ID=
RAZORPAY_PLAN_BUSINESS_ID=
RAZORPAY_PLAN_ENTERPRISE_ID=

# Stripe Payments (USD/EUR/GBP — optional, degrades gracefully)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# WorkOS (SSO/SAML brokering — optional, degrades gracefully)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Field-level Encryption (AES-256 via Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# CORS Origins — JSON array of allowed frontend URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://contrared-dashboard.netlify.app","https://contrared-addin.netlify.app"]

# Frontend URL (for redirect links in emails)
FRONTEND_URL=http://localhost:5173

# Trusted proxy hosts for X-Forwarded-For processing
TRUSTED_PROXY_HOSTS=127.0.0.1

# Transactional Email (Resend — optional, degrades gracefully)
RESEND_API_KEY=
EMAIL_FROM=ContraRed <noreply@contrared.com>

# Sentry Error Monitoring (optional, degrades gracefully)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Fuzzy matching threshold for redline implementer (0.0-1.0)
FUZZY_MATCH_THRESHOLD=0.85

# Zero Data Retention — enterprise privacy mode
ZERO_DATA_RETENTION=true
CONSENT_EVENT_RETENTION_DAYS=365
REGISTERED_CONSENT_MANAGER=false

# Subscription Limits
FREE_TIER_SCANS=5
STARTER_TIER_SCANS=50
PRO_TIER_SCANS=200
BUSINESS_TIER_SCANS=1000
ENTERPRISE_INCLUDED_SCANS=-1
