# ContraRed Backend - Production Environment Variables Template
# Copy to .env.production and fill in real values (NEVER commit .env.production to git)

# Database - Supabase Direct Connection (CRITICAL: use port 5432, NOT 6543)
# Get this from Supabase Project Settings > Database > Connection Pooler > Session mode
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Redis - Upstash (use rediss:// scheme for TLS)
# Get this from Upstash dashboard > Console > Redis CLI > connection string
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379

# Security - Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Store in secure vault, NEVER rotate in production (invalidates all sessions)
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING_GENERATED_ONCE

# AI Services — Vertex AI (enterprise, India data residency)
VERTEX_PROJECT_ID=YOUR_GCP_PROJECT_ID
VERTEX_LOCATION=asia-south1
# Paste full service account JSON here (Render reads it as inline JSON):
GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

# CORS - JSON array of allowed frontend origins
# Update after Netlify sites are created with final URLs
CORS_ORIGINS=["https://contrared-dashboard.netlify.app","https://contrared-addin.netlify.app"]

# Feature Flags
DEBUG=false
ZERO_DATA_RETENTION=true
ANALYSIS_MODE=demo
AI_PROVIDER=gemini

# Optional: Azure OpenAI (fallback provider)
# AZURE_OPENAI_ENDPOINT=https://[your-resource].openai.azure.com/
# AZURE_OPENAI_API_KEY=[api-key]
# AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# Optional: Razorpay Payments
# RAZORPAY_KEY_ID=[key-id]
# RAZORPAY_KEY_SECRET=[key-secret]
